<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tỏ Tình Này!</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background: pink;
      text-align: center;
      padding: 30px;
    }
    .container {
      background: white;
      padding: 20px;
      border-radius: 20px;
      max-width: 600px;
      margin: auto;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }
    img {
      width: 150px;
      margin-bottom: 20px;
    }
    .question {
      font-size: 20px;
      margin-bottom: 15px;
    }
    .options button {
      display: block;
      margin: 10px auto;
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      background-color: #ff69b4;
      color: white;
      border-radius: 10px;
      cursor: pointer;
    }
    .options button:hover {
      background-color: #ff1493;
    }
    .final-input {
      margin-top: 20px;
    }
    #finalMessage {
      font-weight: bold;
      color: green;
      font-size: 22px;
    }
    .hidden {
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <img src="images/heart.png" alt="Trái tim">
    <img src="images/boy_ring.png" alt="Chàng trai cầm nhẫn">

    <div id="quiz">
      <div id="question" class="question"></div>
      <div id="options" class="options"></div>
    </div>

    <div id="final" class="hidden">
      <div class="question">Điền tên chồng vào đây:</div>
      <input type="text" id="husbandInput" placeholder="Tên chồng">
      <br><br>
      <button onclick="checkHusband()">Gửi</button>
      <div id="finalMessage"></div>
    </div>
  </div>

  <script>
    const quizData = [
      {
        question: "Câu 1: Ai là người đẹp trai nhất trong tim em?",
        options: {
          A: "Bố",
          B: "Anh trai",
          C: "Chị gái",
          D: "Anh Huy"
        },
        correct: "D"
      },
      {
        question: "Câu 2: Em sẽ lấy ai?",
        options: {
          A: "Anh Huy",
          B: "Kai",
          C: "Anh cùng làng",
          D: "Zai 18cm"
        },
        correct: "A"
      },
      {
        question: "Câu 3: Đi làm em nhớ ai?",
        options: {
          A: "Bố",
          B: "Mẹ",
          C: "Anh Huy",
          D: "18cm"
        },
        correct: "C"
      },
      {
        question: "Câu 4: Em sẽ lấy ai?",
        options: {
          A: "Anh Huy",
          B: "Anh Huy",
          C: "Anh Huy",
          D: "Anh Huy"
        },
        correct: "A"
      }
    ];

    let currentQuestion = 0;

    function loadQuestion() {
      const q = quizData[currentQuestion];
      document.getElementById("question").textContent = q.question;
      const optionsDiv = document.getElementById("options");
      optionsDiv.innerHTML = "";
      for (const [key, val] of Object.entries(q.options)) {
        const btn = document.createElement("button");
        btn.textContent = `${key}: ${val}`;
        btn.onclick = () => handleAnswer(key);
        optionsDiv.appendChild(btn);
      }
    }

    function handleAnswer(answer) {
      if (answer === quizData[currentQuestion].correct) {
        currentQuestion++;
        if (currentQuestion < quizData.length) {
          loadQuestion();
        } else {
          showFinal();
        }
      } else {
        alert("Sai rồi, thử lại nhé 😝");
      }
    }

    function showFinal() {
      document.getElementById("quiz").classList.add("hidden");
      document.getElementById("final").classList.remove("hidden");
    }

    function checkHusband() {
      const input = document.getElementById("husbandInput").value.trim().toLowerCase();
      const finalMsg = document.getElementById("finalMessage");
      if (input === "a huy" || input === "anh huy") {
        finalMsg.innerHTML = "🎉 Phần thưởng là: <b>ANH HUY</b> và 1 nhẫn kim cương 💍 trị giá <b>100000 tỷ</b>!";
      } else {
        finalMsg.style.color = "red";
        finalMsg.textContent = "Sai rồi! 🚫 ĐI RA MẢ VƯỜN NHA!";
      }
    }

    // Khởi tạo câu hỏi đầu tiên
    loadQuestion();
  </script>
</body>
</html>
